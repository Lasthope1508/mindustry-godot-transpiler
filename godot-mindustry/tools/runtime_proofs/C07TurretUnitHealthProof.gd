extends Node

const main_scene := preload("res://scenes/Main.tscn")
const turret_build_state := preload("res://src/game/SourceTurretBuildState.gd")
const placed_block_state := preload("res://src/game/SourcePlacedBlockState.gd")
const registry := preload("res://src/game/SourceSsotAccessorRuntimeState.gd")
const proof_state := preload("res://tools/runtime_proofs/RuntimeProofState.gd")


func _ready() -> void:
	var proof: Dictionary = {}

	var game := main_scene.instantiate()
	add_child(game)
	for iteration in range(4):
		await get_tree().process_frame
	game.call("enter_campaign_playable_slice")
	for iteration in range(4):
		await get_tree().process_frame
	game.set_process(false)
	game.set_physics_process(false)

	# --- Turret unit live health (N2276): N2275 stamped the
	# maxHealth, but the frame still had no unit health, so
	# reads of the unit's health (healthf(), damaged(), heal())
	# had nothing live. TurretBuild.updateTile()
	# (Turret.java:490-615) syncs its block unit every tick:
	# `unit.tile(this);`
	# (Turret.java:529) -- and tile() sets up the block stats,
	# second line:
	# `health(tile.health);`
	# (BlockUnitComp.java:22) sets the unit health field
	# (`float health;`, HealthComp.java:11; the float setter is
	# generated by the component annotation processor). Duo
	# health is 250 at full health (Blocks.java:3319
	# `health = 250;`). The pure function takes the live tile
	# health and returns the one key `unit_health`. Java order
	# inside tile() is :21 maxHealth, :22 health, :23 hitSize,
	# :24 set -- so the health tick runs AFTER the N2275
	# maxHealth tick and BEFORE the N2260 unit sync tick
	# (hitSize :23) and the N2274 world position tick
	# (set :24), and BEFORE the aim/shoot call, so aim reads a
	# live unit mirror. The live source is the placed-block
	# health meta (SourcePlacedBlockState.health(sprite) reads
	# the sprite meta `source_block_health`, set to the block
	# health at placement), so a damaged duo stamps its live
	# health, not a constant. The direct pure-function calls
	# pin the value behind the driver observables below: the
	# duo health is 250.0 at full health / another tile health
	# passes through unchanged.

	# The direct pure-function calls pin the value behind the
	# driver observables below.
	var direct_duo: Dictionary = turret_build_state.source_turret_unit_health_state(250.0)
	var direct_other: Dictionary = turret_build_state.source_turret_unit_health_state(100.0)

	# The duo health is 250.0 at full health -- directly.
	proof["unit_health_duo"] = absf(float(direct_duo.get("unit_health", 9.9)) - 250.0) < 0.0001
	# Another tile health passes through unchanged -- directly
	# (100.0 in, 100.0 out).
	proof["unit_health_other_value"] = absf(float(direct_other.get("unit_health", 9.9)) - 100.0) < 0.0001

	# One duo segment, live on the driver: the health tick
	# runs before the aim call, so the frame carries a live unit
	# health after a single tick.
	var catalog = game.get("content_catalog")
	var blocks_by_id: Dictionary = {}
	for registered_block in catalog.get_many("block"):
		blocks_by_id[registered_block.id] = registered_block

	var cell := Vector2i(28, 21)
	var segment := Sprite2D.new()
	game.add_child(segment)
	game.call("record_placed_block", segment, blocks_by_id["duo"], cell)
	# The raw Sprite2D node never passes through the texture
	# path (SourceTextureRuntimeState.configure_block_sprite),
	# which is what assigns a placed block its world position
	# (`sprite.position = game.source_block_sprite_base_position(block, cell)`),
	# so without this the segment sits at the origin (0, 0)
	# and the turret-centred query cannot be distinguished
	# from an origin-centred one. Seed the position exactly
	# the way the game does (the N2211 proof lesson).
	segment.position = game.source_block_sprite_base_position(blocks_by_id["duo"], cell)
	turret_build_state.source_turret_bind_frame_state(segment, blocks_by_id["duo"])
	# Damage the duo before the tick: the placed-block health
	# meta is the live tile health (SourcePlacedBlockState
	# sets it to the block health 250.0 at placement), so
	# setting it to 100.0 makes the live tick read 100.0 --
	# proving the driver reads the live health, not a
	# constant 250.0.
	segment.set_meta(placed_block_state.SOURCE_BLOCK_HEALTH_META_KEY, 100.0)

	# One shared tick wires team_id / cheating / enabled onto
	# the frame (and charges the reload by 1/60).
	turret_build_state.source_turret_tick_buildings_state(game, 1.0 / 60.0)
	var frame: Dictionary = segment.get_meta(turret_build_state.SOURCE_TURRET_BUILDING_META_KEY, {})

	# The unit health key is stamped on the frame after the
	# tick, as a live key -- not just computed by the pure
	# function.
	proof["unit_health_stamped_to_frame"] = frame.has("unit_health")
	# The damaged duo live tick stamps 100.0: the live
	# placed-block health -- the stamp is live, not a default
	# left behind.
	proof["unit_health_damaged_live"] = absf(float(frame.get("unit_health", 9.9)) - 100.0) < 0.0001

	var state_registry := registry.canonical_headquarter_registry_state()
	proof["registry_valid"] = state_registry.get("errors", []).is_empty()
	proof["one_headquarter_per_ssot"] = state_registry.get("one_headquarter_per_ssot", false)
	proof["matches"] = proof.values().all(func(value): return value == true)
	proof_state.write_proof("C07TurretUnitHealthProof", proof)
	if "--headless" in OS.get_cmdline_args():
		get_tree().quit(proof_state.exit_code(proof))
