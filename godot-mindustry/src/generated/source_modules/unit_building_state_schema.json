          "used_by": [
            "SourceUnitFactoryBuildState.source_unit_factory_production_tick_state"
          ]
        },
        "plans_count": {
          "type": "int",
          "status": "source-backed",
          "java_source": "core/src/mindustry/world/blocks/units/UnitFactory.java",
          "java_expr": "if(currentPlan < 0 || currentPlan >= plans.size){",
          "rule": "block.properties.unitPlans.size() for the bounds check (updateTile forces plan 0 when the block is not configurable, then -1 when out of range).",
          "used_by": [
            "SourceUnitFactoryBuildState.source_unit_factory_production_tick_state"
          ]
        },
        "edelta": {
          "type": "float",
          "status": "source-backed",
          "java_source": "core/src/mindustry/entities/comp/BuildingComp.java",
          "java_expr": "return efficiency * delta();",
          "rule": "efficiency * delta (BuildingComp.edelta(), BuildingComp.java:1927-1928).",
          "used_by": [
            "SourceUnitFactoryBuildState.source_unit_factory_production_tick_state"
          ]
        },
        "unit_build_speed": {
          "type": "float",
          "status": "source-backed",
          "java_source": "core/src/mindustry/game/Rules.java",
          "java_expr": "return unitBuildSpeedMultiplier * teams.get(team).unitBuildSpeedMultiplier;",
          "rule": "Rules.unitBuildSpeed(team) (Rules.java:271-272): the global unitBuildSpeedMultiplier (default 1f) times the team multiplier (default 1f).",
          "used_by": [
            "SourceUnitFactoryBuildState.source_unit_factory_production_tick_state"
          ]
        },
        "source_delta": {
          "type": "float",
          "status": "source-backed",
          "java_source": "core/src/mindustry/world/blocks/units/UnitFactory.java",
          "java_expr": "speedScl = Mathf.lerpDelta(speedScl, 1f, 0.05f);",
          "rule": "The tick delta for lerpDelta (SourceMathState.source_lerp_delta, Mathf.lerpDelta = lerp(from, to, clamp(progress * Time.delta))).",
          "used_by": [
            "SourceUnitFactoryBuildState.source_unit_factory_production_tick_state"
          ]
        }
      }
