	var next_config: Variant = last_config if (save_config and last_config != null) else null
	return {SOURCE_BLOCK_PLAN_SOURCE_OWNER_KEY: source_runtime_owner_registry.PORT_GAME_SOURCE_BLOCK_NEXT_CONFIG_STATE, SOURCE_BLOCK_PLAN_SOURCE_KEY: SOURCE_BLOCK_PLAN_SOURCE, SOURCE_BLOCK_PLAN_METHOD_KEY: SOURCE_BLOCK_PLAN_NEXT_CONFIG_METHOD, SOURCE_BLOCK_PLAN_GUARD_EXPR_KEY: SOURCE_BLOCK_PLAN_NEXT_CONFIG_GUARD_EXPR, SOURCE_BLOCK_PLAN_LAST_CONFIG_RETURN_EXPR_KEY: SOURCE_BLOCK_PLAN_NEXT_CONFIG_LAST_RETURN_EXPR, SOURCE_BLOCK_PLAN_NULL_RETURN_EXPR_KEY: SOURCE_BLOCK_PLAN_NEXT_CONFIG_NULL_RETURN_EXPR, SOURCE_BLOCK_PLAN_SAVE_CONFIG_KEY: save_config, SOURCE_BLOCK_PLAN_LAST_CONFIG_KEY: last_config, SOURCE_BLOCK_PLAN_LAST_CONFIG_PRESENT_KEY: last_config != null, SOURCE_BLOCK_PLAN_NEXT_CONFIG_KEY: next_config}

static func get_plan_configs_state(options_before: Array, item_configured: bool, liquid_configured: bool, content_items: Array, content_liquids: Array) -> Dictionary:
	var options_after: Array = options_before.duplicate()
	if item_configured:
		options_after.append_array(content_items)
	if liquid_configured:
		options_after.append_array(content_liquids)
	var item_options_added: int = content_items.size() if item_configured else 0
	var liquid_options_added: int = content_liquids.size() if liquid_configured else 0
	return {SOURCE_BLOCK_PLAN_SOURCE_OWNER_KEY: source_runtime_owner_registry.PORT_GAME_SOURCE_BLOCK_GET_PLAN_CONFIGS_STATE, SOURCE_BLOCK_PLAN_SOURCE_KEY: SOURCE_BLOCK_PLAN_SOURCE, SOURCE_BLOCK_PLAN_COMMENT_KEY: SOURCE_BLOCK_PLAN_GET_PLAN_CONFIGS_COMMENT, SOURCE_BLOCK_PLAN_METHOD_KEY: SOURCE_BLOCK_PLAN_GET_PLAN_CONFIGS_METHOD, SOURCE_BLOCK_PLAN_ITEM_GUARD_EXPR_KEY: SOURCE_BLOCK_PLAN_GET_PLAN_CONFIGS_ITEM_GUARD_EXPR, SOURCE_BLOCK_PLAN_ITEM_ADD_EXPR_KEY: SOURCE_BLOCK_PLAN_GET_PLAN_CONFIGS_ITEM_ADD_EXPR, SOURCE_BLOCK_PLAN_LIQUID_GUARD_EXPR_KEY: SOURCE_BLOCK_PLAN_GET_PLAN_CONFIGS_LIQUID_GUARD_EXPR, SOURCE_BLOCK_PLAN_LIQUID_ADD_EXPR_KEY: SOURCE_BLOCK_PLAN_GET_PLAN_CONFIGS_LIQUID_ADD_EXPR, SOURCE_BLOCK_PLAN_OPTIONS_BEFORE_KEY: options_before, SOURCE_BLOCK_PLAN_ITEM_CONFIGURED_KEY: item_configured, SOURCE_BLOCK_PLAN_LIQUID_CONFIGURED_KEY: liquid_configured, SOURCE_BLOCK_PLAN_CONTENT_ITEMS_KEY: content_items, SOURCE_BLOCK_PLAN_CONTENT_LIQUIDS_KEY: content_liquids, SOURCE_BLOCK_PLAN_ITEM_OPTIONS_ADDED_KEY: item_options_added, SOURCE_BLOCK_PLAN_LIQUID_OPTIONS_ADDED_KEY: liquid_options_added, SOURCE_BLOCK_PLAN_OPTIONS_AFTER_KEY: options_after}

static func generated_get_plan_configs_result_state(options_before: Array, item_configured: bool, liquid_configured: bool, content_items: Array, content_liquids: Array) -> Dictionary:
	return get_plan_configs_state(options_before, item_configured, liquid_configured, content_items, content_liquids)

static func generated_block_config_senseable_bridge_state(item_configured: bool, liquid_configured: bool, unlockable_content_configured: bool, block_configured: bool, unit_type_configured: bool) -> Dictionary:
	var result = _block_call(SOURCE_BLOCK_PLAN_CONFIG_SENSEABLE_JAVA_METHOD, [item_configured, liquid_configured, unlockable_content_configured, block_configured, unit_type_configured])
	var canonical = config_senseable_state(item_configured, liquid_configured, unlockable_content_configured, block_configured, unit_type_configured)
	var matches: bool = source_generated_class_runtime.generated_state_matches_canonical_subset(result, canonical)
	return {SOURCE_BLOCK_PLAN_SOURCE_OWNER_KEY: source_runtime_owner_registry.PORT_GAME_SOURCE_BLOCK_CONFIG_SENSEABLE_STATE, SOURCE_BLOCK_PLAN_GENERATED_OWNER_KEY: SOURCE_BLOCK_PLAN_CONFIG_SENSEABLE_GENERATED_OWNER, SOURCE_BLOCK_PLAN_RESULT_KEY: result, SOURCE_BLOCK_PLAN_CANONICAL_KEY: canonical, SOURCE_BLOCK_PLAN_MATCHES_KEY: matches}

static func generated_block_next_config_bridge_state(save_config: bool, last_config: Variant) -> Dictionary:
	var result = _block_call(SOURCE_BLOCK_PLAN_NEXT_CONFIG_JAVA_METHOD, [save_config, last_config])
	var canonical = next_config_state(save_config, last_config)
	var matches: bool = source_generated_class_runtime.generated_state_matches_canonical_subset(result, canonical)
	return {SOURCE_BLOCK_PLAN_SOURCE_OWNER_KEY: source_runtime_owner_registry.PORT_GAME_SOURCE_BLOCK_NEXT_CONFIG_STATE, SOURCE_BLOCK_PLAN_GENERATED_OWNER_KEY: SOURCE_BLOCK_PLAN_NEXT_CONFIG_GENERATED_OWNER, SOURCE_BLOCK_PLAN_RESULT_KEY: result, SOURCE_BLOCK_PLAN_CANONICAL_KEY: canonical, SOURCE_BLOCK_PLAN_MATCHES_KEY: matches}

static func generated_block_get_plan_configs_bridge_state(options_before: Array, item_configured: bool, liquid_configured: bool, content_items: Array, content_liquids: Array) -> Dictionary:
	var result = _block_call(SOURCE_BLOCK_PLAN_GET_PLAN_CONFIGS_JAVA_METHOD, [options_before, item_configured, liquid_configured, content_items, content_liquids])
	var canonical = get_plan_configs_state(options_before, item_configured, liquid_configured, content_items, content_liquids)
	var matches: bool = source_generated_class_runtime.generated_state_matches_canonical_subset(result, canonical)
	return {SOURCE_BLOCK_PLAN_SOURCE_OWNER_KEY: source_runtime_owner_registry.PORT_GAME_SOURCE_BLOCK_GET_PLAN_CONFIGS_STATE, SOURCE_BLOCK_PLAN_GENERATED_OWNER_KEY: SOURCE_BLOCK_PLAN_GET_PLAN_CONFIGS_GENERATED_OWNER, SOURCE_BLOCK_PLAN_RESULT_KEY: result, SOURCE_BLOCK_PLAN_CANONICAL_KEY: canonical, SOURCE_BLOCK_PLAN_MATCHES_KEY: matches}
