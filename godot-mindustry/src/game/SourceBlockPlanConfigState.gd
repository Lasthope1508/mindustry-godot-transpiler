	var config_senseable: bool = item_configured or liquid_configured or unlockable_content_configured or block_configured or unit_type_configured
	return {SOURCE_BLOCK_PLAN_SOURCE_OWNER_KEY: source_runtime_owner_registry.PORT_GAME_SOURCE_BLOCK_CONFIG_SENSEABLE_STATE, SOURCE_BLOCK_PLAN_SOURCE_KEY: SOURCE_BLOCK_PLAN_SOURCE, SOURCE_BLOCK_PLAN_METHOD_KEY: SOURCE_BLOCK_PLAN_CONFIG_SENSEABLE_METHOD, SOURCE_BLOCK_PLAN_RETURN_EXPR_KEY: SOURCE_BLOCK_PLAN_CONFIG_SENSEABLE_RETURN_EXPR, SOURCE_BLOCK_PLAN_ITEM_CONFIGURED_2_KEY: item_configured, SOURCE_BLOCK_PLAN_LIQUID_CONFIGURED_2_KEY: liquid_configured, SOURCE_BLOCK_PLAN_UNLOCKABLE_CONTENT_CONFIGURED_KEY: unlockable_content_configured, SOURCE_BLOCK_PLAN_BLOCK_CONFIGURED_KEY: block_configured, SOURCE_BLOCK_PLAN_UNIT_TYPE_CONFIGURED_KEY: unit_type_configured, SOURCE_BLOCK_PLAN_CONFIG_SENSEABLE_KEY: config_senseable}

