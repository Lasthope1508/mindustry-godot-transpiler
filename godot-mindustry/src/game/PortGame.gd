	var damage := bullet_building_damage
	var armor := block_armor * bullet_armor_multiplier * bullet_block_armor_multiplier
	if not bullet_pierce_armor:
		damage = max(damage - armor, 0.1 * damage)
	return {
		"was_dead": current_health <= 0.0,
