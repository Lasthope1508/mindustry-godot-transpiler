		"rotationAssignment": SOURCE_UNIT_ROTATE_MOVE_ROTATION_ASSIGNMENT,
		"vec2IsZero": SOURCE_UNIT_ROTATE_MOVE_VEC2_IS_ZERO,
		"vec2Angle": SOURCE_UNIT_ROTATE_MOVE_VEC2_ANGLE,
