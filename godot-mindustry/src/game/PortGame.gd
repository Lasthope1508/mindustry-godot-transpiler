					"distance": distance,
					"strength": strength,
					"velocity": {"x": dx * length_factor * knockback_scale, "y": dy * length_factor * knockback_scale},
				})
	return {
		"guard": guard,
		"relativeSize": relative_size,
		"knockbacks": knockbacks,
	}

