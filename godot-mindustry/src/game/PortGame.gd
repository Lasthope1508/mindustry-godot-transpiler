		"shootXOffset": shoot_x_offset,
		"yOffset": y_offset,
		"xSpread": x_spread,
		"trnsx": float(trns.get("x", 0.0)),
		"trnsy": float(trns.get("y", 0.0)),
		"bulletX": origin_x + float(trns.get("x", 0.0)),
		"bulletY": origin_y + float(trns.get("y", 0.0)),
