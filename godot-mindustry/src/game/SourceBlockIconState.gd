static func create_icons_state(super_state: Dictionary, synthetic: bool, full_icon_width: int, full_icon_height: int, full_icon_center_color: Variant, map_color_before: Variant, name_value: String, team_region_found: bool, teams: Array, team_region: Variant, team_regions_before: Array, atlas_team_overrides: Array, outline_icon: bool, outlined_icon: int, outline_radius: int, generated_icons: Array, custom_regions_to_outline: Array) -> Dictionary:
	var map_color_after: Variant = map_color_before
	if not synthetic and full_icon_width > 0 and full_icon_height > 0:
		map_color_after = full_icon_center_color
	var team_assignments: Array = []
	var team_regions_after: Array = team_regions_before.duplicate()
	if team_region_found:
		for team in teams:
			var team_id: int = int(team.get(SOURCE_BLOCK_ICON_INPUT_TEAM_ID_KEY, 0))
			var team_name: String = str(team.get(SOURCE_BLOCK_ICON_INPUT_TEAM_NAME_KEY, ""))
			var has_palette: bool = bool(team.get(SOURCE_BLOCK_ICON_INPUT_TEAM_PALETTE_KEY, false))
			var overridden: bool = atlas_team_overrides.has(name_value + "-team-" + team_name)
			var generated: bool = has_palette and not overridden
			var assigned_region: Variant = team_region
			if team_region_found and has_palette:
				assigned_region = "Core.atlas.find(%s-team-%s, %s)" % [name_value, team_name, str(team_region)]
			if team_id >= 0 and team_id < team_regions_after.size():
				team_regions_after[team_id] = assigned_region
			team_assignments.append({SOURCE_BLOCK_ICON_TEAM_ID_KEY: team_id, SOURCE_BLOCK_ICON_TEAM_NAME_KEY: team_name, SOURCE_BLOCK_ICON_HAS_PALETTE_KEY: has_palette, SOURCE_BLOCK_ICON_OVERRIDDEN_KEY: overridden, SOURCE_BLOCK_ICON_GENERATED_KEY: generated, SOURCE_BLOCK_ICON_ASSIGNED_REGION_KEY: assigned_region})
	var outline_operation: Variant = null
	if outline_icon and generated_icons.size() > 0:
		var outline_index: int = outlined_icon if outlined_icon >= 0 else generated_icons.size() - 1
		outline_operation = {SOURCE_BLOCK_ICON_INDEX_KEY: mini(outline_index, generated_icons.size() - 1), SOURCE_BLOCK_ICON_RADIUS_KEY: outline_radius, SOURCE_BLOCK_ICON_CALL_KEY: SOURCE_BLOCK_CREATE_ICONS_OUTLINE_CALL}
	var composite: Dictionary = {SOURCE_BLOCK_ICON_MODE_KEY: SOURCE_BLOCK_ICON_SINGLE_MODE, SOURCE_BLOCK_ICON_ICONS_KEY: generated_icons}
	if generated_icons.size() > 1:
		composite = {SOURCE_BLOCK_ICON_MODE_KEY: SOURCE_BLOCK_ICON_COMPOSITE_MODE, SOURCE_BLOCK_ICON_ICONS_KEY: generated_icons, SOURCE_BLOCK_ICON_OUTPUT_NAME_KEY: SOURCE_BLOCK_ICON_FULL_OUTPUT_FORMAT % name_value}
	return {SOURCE_BLOCK_ICON_SOURCE_OWNER_KEY: source_runtime_owner_registry.PORT_GAME_SOURCE_BLOCK_CREATE_ICONS_STATE, SOURCE_BLOCK_ICON_SOURCE_KEY: SOURCE_BLOCK_ICON_SOURCE, SOURCE_BLOCK_ICON_METHOD_KEY: SOURCE_BLOCK_CREATE_ICONS_METHOD, SOURCE_BLOCK_ICON_SUPER_CALL_EXPR_KEY: SOURCE_BLOCK_CREATE_ICONS_SUPER_CALL, SOURCE_BLOCK_ICON_MAP_COLOR_EXPR_KEY: SOURCE_BLOCK_CREATE_ICONS_MAP_COLOR_EXPR, SOURCE_BLOCK_ICON_TEAM_GUARD_EXPR_KEY: SOURCE_BLOCK_CREATE_ICONS_TEAM_GUARD, SOURCE_BLOCK_ICON_TEAM_OVERRIDE_GUARD_EXPR_KEY: SOURCE_BLOCK_CREATE_ICONS_TEAM_OVERRIDE_GUARD, SOURCE_BLOCK_ICON_TEAM_PALETTE_LOOP_EXPR_KEY: SOURCE_BLOCK_CREATE_ICONS_TEAM_PALETTE_LOOP, SOURCE_BLOCK_ICON_TEAM_ASSIGNMENT_EXPR_KEY: SOURCE_BLOCK_CREATE_ICONS_TEAM_ASSIGNMENT, SOURCE_BLOCK_ICON_OUTLINE_GUARD_EXPR_KEY: SOURCE_BLOCK_CREATE_ICONS_OUTLINE_GUARD, SOURCE_BLOCK_ICON_OUTLINE_CALL_EXPR_KEY: SOURCE_BLOCK_CREATE_ICONS_OUTLINE_CALL, SOURCE_BLOCK_ICON_CUSTOM_OUTLINE_LOOP_EXPR_KEY: SOURCE_BLOCK_CREATE_ICONS_CUSTOM_OUTLINE_LOOP, SOURCE_BLOCK_ICON_COMPOSITE_GUARD_EXPR_KEY: SOURCE_BLOCK_CREATE_ICONS_COMPOSITE_GUARD, SOURCE_BLOCK_ICON_DISPOSE_EXPR_KEY: SOURCE_BLOCK_CREATE_ICONS_DISPOSE, SOURCE_BLOCK_ICON_SUPER_STATE_KEY: super_state, SOURCE_BLOCK_ICON_SYNTHETIC_KEY: synthetic, SOURCE_BLOCK_ICON_FULL_ICON_WIDTH_KEY: full_icon_width, SOURCE_BLOCK_ICON_FULL_ICON_HEIGHT_KEY: full_icon_height, SOURCE_BLOCK_ICON_FULL_ICON_CENTER_COLOR_KEY: full_icon_center_color, SOURCE_BLOCK_ICON_MAP_COLOR_BEFORE_KEY: map_color_before, SOURCE_BLOCK_ICON_MAP_COLOR_AFTER_KEY: map_color_after, SOURCE_BLOCK_ICON_NAME_KEY: name_value, SOURCE_BLOCK_ICON_TEAM_REGION_FOUND_KEY: team_region_found, SOURCE_BLOCK_ICON_TEAMS_KEY: teams, SOURCE_BLOCK_ICON_TEAM_REGION_KEY: team_region, SOURCE_BLOCK_ICON_TEAM_REGIONS_BEFORE_KEY: team_regions_before, SOURCE_BLOCK_ICON_TEAM_REGIONS_AFTER_KEY: team_regions_after, SOURCE_BLOCK_ICON_ATLAS_TEAM_OVERRIDES_KEY: atlas_team_overrides, SOURCE_BLOCK_ICON_TEAM_ASSIGNMENTS_KEY: team_assignments, SOURCE_BLOCK_ICON_OUTLINE_ICON_KEY: outline_icon, SOURCE_BLOCK_ICON_OUTLINED_ICON_KEY: outlined_icon, SOURCE_BLOCK_ICON_OUTLINE_RADIUS_KEY: outline_radius, SOURCE_BLOCK_ICON_GENERATED_ICONS_KEY: generated_icons, SOURCE_BLOCK_ICON_CUSTOM_REGIONS_TO_OUTLINE_KEY: custom_regions_to_outline, SOURCE_BLOCK_ICON_OUTLINE_OPERATION_KEY: outline_operation, SOURCE_BLOCK_ICON_COMPOSITE_KEY: composite, SOURCE_BLOCK_ICON_DISPOSED_KEY: true}

