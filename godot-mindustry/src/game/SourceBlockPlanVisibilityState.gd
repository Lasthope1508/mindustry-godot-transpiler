static func _block_call(generated_method: String, generated_args: Array) -> Variant:
	return source_generated_class_runtime.call_java_method(SOURCE_BLOCK_GENERATED_CLASS, generated_method, generated_args, null)

static func is_hidden_state(build_visibility_visible: bool, revealed_blocks_contains_self: bool) -> Dictionary:
	var is_hidden_value: bool = (not build_visibility_visible) and (not revealed_blocks_contains_self)
	return {SOURCE_BLOCK_PLAN_SOURCE_OWNER_KEY: source_runtime_owner_registry.PORT_GAME_SOURCE_BLOCK_IS_HIDDEN_STATE, SOURCE_BLOCK_PLAN_SOURCE_KEY: SOURCE_BLOCK_PLAN_SOURCE, SOURCE_BLOCK_PLAN_OVERRIDE_EXPR_KEY: "@Override", SOURCE_BLOCK_PLAN_METHOD_KEY: SOURCE_BLOCK_PLAN_IS_HIDDEN_METHOD, SOURCE_BLOCK_PLAN_RETURN_EXPR_KEY: SOURCE_BLOCK_PLAN_IS_HIDDEN_RETURN_EXPR, SOURCE_BLOCK_PLAN_BUILD_VISIBILITY_VISIBLE_KEY: build_visibility_visible, SOURCE_BLOCK_PLAN_REVEALED_BLOCKS_CONTAINS_SELF_KEY: revealed_blocks_contains_self, SOURCE_BLOCK_PLAN_IS_HIDDEN_KEY: is_hidden_value}

static func generated_is_hidden_result_state(build_visibility_visible: bool, revealed_blocks_contains_self: bool) -> Dictionary:
	return is_hidden_state(build_visibility_visible, revealed_blocks_contains_self)

static func is_visible_state(is_hidden_value: bool, state_rules_editor: bool, state_rules_hide_banned_blocks: bool, is_banned_value: bool) -> Dictionary:
	var is_visible_value: bool = (not is_hidden_value) and (state_rules_editor or ((not state_rules_hide_banned_blocks) or (not is_banned_value)))
	return {SOURCE_BLOCK_PLAN_SOURCE_OWNER_KEY: source_runtime_owner_registry.PORT_GAME_SOURCE_BLOCK_IS_VISIBLE_STATE, SOURCE_BLOCK_PLAN_SOURCE_KEY: SOURCE_BLOCK_PLAN_SOURCE, SOURCE_BLOCK_PLAN_METHOD_KEY: SOURCE_BLOCK_PLAN_IS_VISIBLE_METHOD, SOURCE_BLOCK_PLAN_RETURN_EXPR_KEY: SOURCE_BLOCK_PLAN_IS_VISIBLE_RETURN_EXPR, SOURCE_BLOCK_PLAN_IS_HIDDEN_KEY: is_hidden_value, SOURCE_BLOCK_PLAN_STATE_RULES_EDITOR_KEY: state_rules_editor, SOURCE_BLOCK_PLAN_STATE_RULES_HIDE_BANNED_BLOCKS_KEY: state_rules_hide_banned_blocks, SOURCE_BLOCK_PLAN_IS_BANNED_KEY: is_banned_value, SOURCE_BLOCK_PLAN_IS_VISIBLE_KEY: is_visible_value}

static func generated_is_visible_result_state(is_hidden_value: bool, state_rules_editor: bool, state_rules_hide_banned_blocks: bool, is_banned_value: bool) -> Dictionary:
	return is_visible_state(is_hidden_value, state_rules_editor, state_rules_hide_banned_blocks, is_banned_value)

static func is_placeable_state(is_visible_value: bool, is_banned_value: bool, state_rules_editor: bool, supports_env_value: bool) -> Dictionary:
	var is_placeable_value: bool = is_visible_value and ((not is_banned_value) or state_rules_editor) and supports_env_value
	return {SOURCE_BLOCK_PLAN_SOURCE_OWNER_KEY: source_runtime_owner_registry.PORT_GAME_SOURCE_BLOCK_IS_PLACEABLE_STATE, SOURCE_BLOCK_PLAN_SOURCE_KEY: SOURCE_BLOCK_PLAN_SOURCE, SOURCE_BLOCK_PLAN_METHOD_KEY: SOURCE_BLOCK_PLAN_IS_PLACEABLE_METHOD, SOURCE_BLOCK_PLAN_RETURN_EXPR_KEY: SOURCE_BLOCK_PLAN_IS_PLACEABLE_RETURN_EXPR, SOURCE_BLOCK_PLAN_IS_VISIBLE_KEY: is_visible_value, SOURCE_BLOCK_PLAN_IS_BANNED_KEY: is_banned_value, SOURCE_BLOCK_PLAN_STATE_RULES_EDITOR_KEY: state_rules_editor, SOURCE_BLOCK_PLAN_SUPPORTS_ENV_KEY: supports_env_value, SOURCE_BLOCK_PLAN_IS_PLACEABLE_KEY: is_placeable_value}

static func generated_is_placeable_result_state(is_visible_value: bool, is_banned_value: bool, state_rules_editor: bool, supports_env_value: bool) -> Dictionary:
	return is_placeable_state(is_visible_value, is_banned_value, state_rules_editor, supports_env_value)

static func generated_block_is_hidden_bridge_state(build_visibility_visible: bool, revealed_blocks_contains_self: bool) -> Dictionary:
	var result = _block_call(SOURCE_BLOCK_PLAN_IS_HIDDEN_JAVA_METHOD, [build_visibility_visible, revealed_blocks_contains_self])
	var canonical = is_hidden_state(build_visibility_visible, revealed_blocks_contains_self)
	var matches: bool = source_generated_class_runtime.generated_state_matches_canonical_subset(result, canonical)
	return {SOURCE_BLOCK_PLAN_SOURCE_OWNER_KEY: source_runtime_owner_registry.PORT_GAME_SOURCE_BLOCK_IS_HIDDEN_STATE, SOURCE_BLOCK_PLAN_GENERATED_OWNER_KEY: SOURCE_BLOCK_PLAN_IS_HIDDEN_GENERATED_OWNER, SOURCE_BLOCK_PLAN_RESULT_KEY: result, SOURCE_BLOCK_PLAN_CANONICAL_KEY: canonical, SOURCE_BLOCK_PLAN_MATCHES_KEY: matches}

