		SOURCE_BUILDING_POWER_MANUAL_LINK_ADDED_COUNT_KEY: manual_link_added_indices.size(),
		SOURCE_BUILDING_POWER_MANUAL_LINK_COUNT_KEY: link_present_by_index.size(),
