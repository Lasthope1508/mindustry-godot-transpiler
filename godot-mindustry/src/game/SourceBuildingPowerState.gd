			proximity_guard_pass_indices.append(index)
	return {
		SOURCE_BUILDING_POWER_METHOD_KEY: SOURCE_BUILDING_POWER_GET_POWER_CONNECTIONS_METHOD,
		SOURCE_BUILDING_POWER_PROXIMITY_LOOP: SOURCE_BUILDING_POWER_PROXIMITY_LOOP,
