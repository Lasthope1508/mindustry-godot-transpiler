		SOURCE_BUILDING_POWER_OTHER_PRESENT_BY_INDEX_KEY: other_present_by_index.duplicate(true),
		SOURCE_BUILDING_POWER_OTHER_POWER_PRESENT_BY_INDEX_KEY: other_power_present_by_index.duplicate(true),
