static func get_satisfaction_state(last_power_produced: float, last_power_needed: float) -> Dictionary:
	var satisfaction := 0.0
	if absf(last_power_produced) <= SOURCE_FLOAT_ROUNDING_ERROR:
		satisfaction = 0.0
	elif absf(last_power_needed) <= SOURCE_FLOAT_ROUNDING_ERROR:
		satisfaction = 1.0
	else:
		satisfaction = clamp(last_power_produced / last_power_needed, 0.0, 1.0)
	return {"source_owner": source_runtime_owner_registry.PORT_GAME_SOURCE_POWER_GRAPH_GET_SATISFACTION_STATE, "field": SOURCE_POWER_GRAPH_GET_SATISFACTION_FIELD, "method": SOURCE_POWER_GRAPH_GET_SATISFACTION_METHOD, "produced_zero_guard": SOURCE_POWER_GRAPH_GET_SATISFACTION_PRODUCED_ZERO_GUARD, "return_zero": SOURCE_POWER_GRAPH_GET_SATISFACTION_RETURN_ZERO, "needed_zero_guard": SOURCE_POWER_GRAPH_GET_SATISFACTION_NEEDED_ZERO_GUARD, "return_one": SOURCE_POWER_GRAPH_GET_SATISFACTION_RETURN_ONE, "return_clamp": SOURCE_POWER_GRAPH_GET_SATISFACTION_RETURN_CLAMP, "last_power_produced": last_power_produced, "last_power_needed": last_power_needed, "satisfaction": satisfaction}

static func to_string_state(producers: String, consumers: String, batteries: String, all: String, graph_id: int) -> String:
	return SOURCE_POWER_GRAPH_TO_STRING_PREFIX + producers + ", consumers=" + consumers + ", batteries=" + batteries + ", all=" + all + ", graphID=" + str(graph_id) + "}"
