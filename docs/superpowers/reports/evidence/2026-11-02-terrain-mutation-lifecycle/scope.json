        "--- \n",
        "+++ \n",
        "@@ -108,2 +108,46 @@\n",
        " \treturn {\"changed\": true, \"proximity_updated\": applied}",
        "+",
        "+# Apply Tile.setFloor assignment and its Building notification; other Tile side effects have separate owners.",
        "+static func source_set_world_floor_state(game: Object, x: int, y: int, floor_block: Object) -> Dictionary:",
        "+\tvar tile: Variant = source_world_tile(game.get(\"source_world_tiles\"), x, y)",
        "+\tassert(tile != null and floor_block != null, \"Tile floor mutation requires resolved world/content\")",
        "+\tvar sprite: Variant = game.call(\"block_sprite_at_cell\", Vector2i(x, y))",
        "+\tvar mutation := source_block_geometry.tile_floor_assignment_state(floor_block, tile[\"floor\"], sprite != null)",
        "+\tif mutation[\"same_floor\"]:",
        "+\t\treturn {\"changed\": false, \"proximity_updated\": false}",
        "+\ttile[\"floor\"] = mutation[\"floor\"]",
        "+\tvar applied := false",
        "+\tif mutation[\"build_proximity_updated\"]:",
        "+\t\tvar catalog: Object = game.get(\"content_catalog\")",
        "+\t\tvar placed_block: Object = catalog.get_by_id(sprite.get_meta(SourcePlacedBlockState.SOURCE_BLOCK_ID_META_KEY))",
        "+\t\tapplied = SourceDrillConsumptionRuntimeState.source_on_proximity_update_state(game, sprite, placed_block)[\"applied\"]",
        "+\treturn {\"changed\": true, \"proximity_updated\": applied}",
        "+",
        "+static func source_set_world_overlay_quiet_state(game: Object, x: int, y: int, block: Object) -> void:",
        "+\tvar tile: Variant = source_world_tile(game.get(\"source_world_tiles\"), x, y)",
        "+\tassert(tile != null and block != null, \"Tile overlay mutation requires resolved world/content\")",
        "+\tvar mutation := source_block_geometry.tile_overlay_mutation_state(\"set_overlay_quiet\", block)",
        "+\ttile[\"overlay\"] = mutation[\"overlay\"]",
        "+",
        "+static func source_clear_world_overlay_state(game: Object, x: int, y: int, generating: bool) -> Dictionary:",
        "+\tvar air: Object = source_world_block_by_field(game.get(\"content_catalog\"), SOURCE_WORLD_AIR_FIELD)",
        "+\tvar mutation := source_block_geometry.tile_overlay_mutation_state(\"clear_overlay\", null, null, false, generating, false, null, air)",
        "+\treturn source_set_world_overlay_state(game, x, y, mutation[\"overlay\"], generating)",
        "+",
        "+# Execute the existing canonical receiver recipe in order; no networking transport is implied.",
        "+static func source_set_world_floor_overlay_state(game: Object, x: int, y: int, floor_block: Object, overlay_block: Object, generating: bool) -> Dictionary:",
        "+\tvar tile: Variant = source_world_tile(game.get(\"source_world_tiles\"), x, y)",
        "+\tassert(tile != null)",
        "+\tvar recipe := source_block_geometry.tile_single_mutation_state(\"set_floor\", tile, floor_block, overlay_block, 0, true)",
        "+\tvar result: Dictionary = {}",
        "+\tfor mutation in recipe[\"calls\"]:",
        "+\t\tif mutation.has(\"floor\"):",
        "+\t\t\tresult[\"floor_state\"] = source_set_world_floor_state(game, x, y, mutation[\"floor\"])",
        "+\t\telse:",
        "+\t\t\tresult[\"overlay_state\"] = source_set_world_overlay_state(game, x, y, mutation[\"overlay\"], generating)",
        "+\treturn result",
        "+",
        "+static func source_set_world_floor_default_state(game: Object, x: int, y: int, floor_block: Object, generating: bool) -> Dictionary:",
        "+\tvar air: Object = source_world_block_by_field(game.get(\"content_catalog\"), SOURCE_WORLD_AIR_FIELD)",
        "+\treturn source_set_world_floor_overlay_state(game, x, y, floor_block, air, generating)",
        " "
      ]
