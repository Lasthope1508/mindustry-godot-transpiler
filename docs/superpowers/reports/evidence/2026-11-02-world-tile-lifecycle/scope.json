    "godot-mindustry/src/game/SourceWorldTerrainRuntimeState.gd": {
      "preexisting_dirty": true,
      "delta": [
        "--- \n",
        "+++ \n",
        "@@ -5,2 +5,89 @@\n",
        " const source_block_query_basic_state := preload(\"res://src/game/SourceBlockQueryBasicState.gd\")",
        "+const SOURCE_WORLD_AIR_FIELD := \"air\"",
        "+const SOURCE_WORLD_STONE_FIELD := \"stone\"",
        "+const SOURCE_WORLD_SCENARIO_ORE_FIELD := \"oreCopper\"",
        "+const source_block_metadata_state := preload(\"res://src/game/SourceBlockMetadataState.gd\")",
        "+const source_block_init_placement_state := preload(\"res://src/game/SourceBlockInitPlacementState.gd\")",
        "+",
        "+static func source_block_geometry_state(block: Object, source_tilesize: float) -> Dictionary:",
        "+\tassert(block != null and block.content_type == \"block\", \"World Tile block definition is unresolved\")",
        "+\tvar size: int = source_block_metadata_state.block_size(block)",
        "+\tvar initialized: Dictionary = source_block_init_placement_state.offset_state(size, source_tilesize)",
        "+\treturn {\"size\": size, \"size_offset\": initialized[\"size_offset_after\"], \"is_multiblock\": source_block_query_basic_state.is_multiblock_state(size)[\"is_multiblock\"]}",
        "+",
        "+static func source_world_tiles_state(width: int, height: int, air_block: Object) -> Dictionary:",
        "+\tassert(width > 0 and height > 0)",
        "+\tvar tiles: Array = []",
        "+\tfor index in range(width * height):",
        "+\t\ttiles.append({\"x\": index % width, \"y\": int(index / width), \"floor\": air_block, \"overlay\": air_block, \"block\": air_block})",
        "+\treturn {\"width\": width, \"height\": height, \"array\": tiles}",
        "+",
        "+static func source_world_tile(world_tiles: Dictionary, x: int, y: int) -> Variant:",
        "+\tif x < 0 or x >= world_tiles[\"width\"] or y < 0 or y >= world_tiles[\"height\"]:",
        "+\t\treturn null",
        "+\treturn world_tiles[\"array\"][y * world_tiles[\"width\"] + x]",
        "+",
        "+static func source_record_world_block(world_tiles: Dictionary, block: Object, x: int, y: int, source_tilesize: float) -> void:",
        "+\tvar self_tile: Variant = source_world_tile(world_tiles, x, y)",
        "+\tif self_tile == null:",
        "+\t\treturn",
        "+\tvar geometry: Dictionary = source_block_geometry_state(block, source_tilesize)",
        "+\tvar linked: Array = []",
        "+\tvar lookup := func(tile_x: int, tile_y: int) -> Variant: return source_world_tile(world_tiles, tile_x, tile_y)",
        "+\tsource_block_geometry.tile_get_linked_tiles_as_array_state(geometry[\"is_multiblock\"], geometry[\"size\"], geometry[\"size_offset\"], x, y, lookup, self_tile, linked)",
        "+\t# Field/proxy assignment only. Removal, overlapping entity cleanup and events have separate lifecycle gates.",
        "+\tfor tile in linked:",
        "+\t\ttile[\"block\"] = block",
        "+",
        "+static func _source_block_by_id(content_catalog: Object, id: String) -> Object:",
        "+\tvar block: Object = content_catalog.call(\"get_by_id\", id)",
        "+\tassert(block != null and block.content_type == \"block\", \"World Tile block definition is unresolved: \" + id)",
        "+\treturn block",
        "+",
        "+static func source_world_block_by_field(content_catalog: Object, field: String) -> Object:",
        "+\tfor block in content_catalog.call(\"get_many\", \"block\"):",
        "+\t\tif block.field == field:",
        "+\t\t\treturn block",
        "+\tassert(false, \"World Tile block definition is unresolved: \" + field)",
        "+\treturn null",
        "+",
        "+static func source_campaign_world_tiles_state(campaign_map_tile_state: Dictionary, content_catalog: Object, source_tilesize: float) -> Dictionary:",
        "+\tvar air: Object = source_world_block_by_field(content_catalog, SOURCE_WORLD_AIR_FIELD)",
        "+\tvar world_tiles := source_world_tiles_state(campaign_map_tile_state[\"width\"], campaign_map_tile_state[\"height\"], air)",
        "+\tvar created: int = 0",
        "+\tfor run in campaign_map_tile_state[\"floor_runs\"]:",
        "+\t\tvar start_index: int = run[\"y\"] * world_tiles[\"width\"] + run[\"x\"]",
        "+\t\tvar length: int = run[\"run_length\"]",
        "+\t\tassert(start_index == created and length > 0 and created + length <= world_tiles[\"array\"].size(), \"World Tile floor runs must cover the map\")",
        "+\t\tvar floor_block: Object = _source_block_by_id(content_catalog, run[\"floor_name\"])",
        "+\t\tif is_same(floor_block, air):",
        "+\t\t\tfloor_block = source_world_block_by_field(content_catalog, SOURCE_WORLD_STONE_FIELD)",
        "+\t\tvar overlay: Object = _source_block_by_id(content_catalog, run[\"overlay_name\"])",
        "+\t\tfor index in range(start_index, start_index + length):",
        "+\t\t\tworld_tiles[\"array\"][index][\"floor\"] = floor_block",
        "+\t\t\tworld_tiles[\"array\"][index][\"overlay\"] = overlay",
        "+\t\tcreated += length",
        "+\tassert(created == world_tiles[\"array\"].size(), \"World Tile floor runs must cover the map\")",
        "+\tfor placement in campaign_map_tile_state[\"block_placements\"]:",
        "+\t\tvar block: Object = _source_block_by_id(content_catalog, placement[\"key\"])",
        "+\t\tsource_record_world_block(world_tiles, block, placement[\"cell\"][\"x\"], placement[\"cell\"][\"y\"], source_tilesize)",
        "+\treturn world_tiles",
        "+",
        "+static func source_game_world_tiles_state(game: Object, initial_build_state: Dictionary) -> Dictionary:",
        "+\tvar catalog: Object = game.get(\"content_catalog\")",
        "+\tvar map: Dictionary = initial_build_state.get(\"campaign_map_tile\", {})",
        "+\tif bool(map.get(\"map_region_consumed\", false)):",
        "+\t\treturn source_campaign_world_tiles_state(map, catalog, float(game.get(\"tile_size\")))",
        "+\tvar air: Object = source_world_block_by_field(catalog, SOURCE_WORLD_AIR_FIELD)",
        "+\tvar floor_block: Object = source_world_block_by_field(catalog, SOURCE_WORLD_STONE_FIELD)",
        "+\tvar overlay: Object = source_world_block_by_field(catalog, SOURCE_WORLD_SCENARIO_ORE_FIELD)",
        "+\tvar dimensions: Vector2i = source_playable_scenario_defaults.world_size()",
        "+\tvar world_tiles := source_world_tiles_state(dimensions.x, dimensions.y, air)",
        "+\tfor tile in world_tiles[\"array\"]:",
        "+\t\ttile[\"floor\"] = floor_block",
        "+\tfor cell in source_playable_scenario_defaults.ore_copper_cells():",
        "+\t\tvar tile: Variant = source_world_tile(world_tiles, cell.x, cell.y)",
        "+\t\tif tile != null:",
        "+\t\t\ttile[\"overlay\"] = overlay",
        "+\treturn world_tiles",
        " "
      ]
    },
