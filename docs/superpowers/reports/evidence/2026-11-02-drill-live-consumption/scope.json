        "-\tif not (placed_block_origins_value is Dictionary):",
        "-\t\treturn",
        "-\tvar placed_block_origins: Dictionary = placed_block_origins_value",
        "-\tfor key in placed_block_origins.keys():",
        "-\t\tdecay_time_scale_sprite(game, placed_block_origins.get(key), source_delta, default_time_scale)",
        "+\tfor sprite in source_unique_buildings_state(game)[\"buildings\"]:",
        "+\t\tdecay_time_scale_sprite(game, sprite, source_delta, default_time_scale)",
