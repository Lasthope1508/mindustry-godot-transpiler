    "godot-mindustry/src/game/SourceConsumeLiquidState.gd": {
      "preexisting_dirty": true,
      "delta": [
        "--- \n",
        "+++ \n",
        "@@ -2,2 +2,31 @@\n",
        " class_name SourceConsumeLiquidState",
        "+",
        "+const source_runtime_storage := preload(\"res://src/game/SourceLiquidModuleState.gd\")",
        "+const source_runtime_time := preload(\"res://src/game/SourceBuildingTimeState.gd\")",
        "+",
        "+class RuntimeConsumer extends RefCounted:",
        "+\tvar definition: Dictionary",
        "+\tvar liquids: Dictionary",
        "+\tvar cache_sums: Array",
        "+\tvar cost_multiplier: Callable",
        "+\tvar source_delta: float",
        "+\tvar time_scale: float",
        "+",
        "+\tfunc efficiency(build: Dictionary) -> float:",
        "+\t\tvar available = SourceConsumeLiquidState.source_runtime_storage.source_get_state(liquids, definition[\"liquid\"])[\"amount\"]",
        "+\t\tvar edelta = SourceConsumeLiquidState.source_runtime_time.edelta(source_delta, time_scale, build[\"efficiency\"])",
        "+\t\treturn SourceConsumeLiquidState.efficiency_state(available, definition[\"amount\"], edelta, build[\"efficiency_scale\"], cost_multiplier.call(build)[\"multiplier\"])[\"efficiency\"]",
        "+",
        "+\tfunc update(build: Dictionary) -> void:",
        "+\t\tvar edelta = SourceConsumeLiquidState.source_runtime_time.edelta(source_delta, time_scale, build[\"efficiency\"])",
        "+\t\tvar request = SourceConsumeLiquidState.update_state(definition[\"liquid\"], definition[\"amount\"], edelta, cost_multiplier.call(build)[\"multiplier\"])",
        "+\t\tSourceConsumeLiquidState.source_runtime_storage.source_remove_state(liquids, definition[\"liquid\"], request[\"remove_amount\"], cache_sums)",
        "+",
        "+static func source_runtime_consumer_state(definition: Dictionary, liquids: Dictionary, cache_sums: Array, cost_multiplier: Callable) -> Dictionary:",
        "+\tvar consumer := RuntimeConsumer.new()",
        "+\tconsumer.definition = definition",
        "+\tconsumer.liquids = liquids",
        "+\tconsumer.cache_sums = cache_sums",
        "+\tconsumer.cost_multiplier = cost_multiplier",
        "+\treturn {\"consumer\": consumer}",
        " "
      ]
    },
