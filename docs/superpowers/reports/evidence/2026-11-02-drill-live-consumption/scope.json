        "--- \n",
        "+++ \n",
        "@@ -2,2 +2,15 @@\n",
        " class_name SourcePlacedBlockState",
        "+",
        "+static func source_unique_buildings_state(game: Object) -> Dictionary:",
        "+\tvar buildings: Array = []",
        "+\tvar seen: Dictionary = {}",
        "+\tvar placed_blocks: Dictionary = game.get(\"placed_blocks\")",
        "+\tfor sprite in placed_blocks.values():",
        "+\t\tif not is_instance_valid(sprite) or not sprite is Sprite2D:",
        "+\t\t\tcontinue",
        "+\t\tvar identity: int = sprite.get_instance_id()",
        "+\t\tif not seen.has(identity):",
        "+\t\t\tseen[identity] = true",
        "+\t\t\tbuildings.append(sprite)",
        "+\treturn {\"buildings\": buildings}",
        " ",
        "@@ -150,8 +163,4 @@\n",
        " static func simulate_time_scales(game: Object, source_delta: float, default_time_scale: float) -> void:",
